
# LLM配置 (从LangGraph继承,如需覆盖可在此配置)
# 模型名称
LLM_MODEL_ID="deepseek-chat"

# API密钥
LLM_API_KEY=your_deepseek_api_key

# 服务地址
LLM_BASE_URL=https://api.deepseek.com/v1

# 超时时间（可选，默认30秒）
LLM_TIMEOUT=30
LLM_MAX_RETRIES=1

# RAG / 本地旅行攻略配置
# local 会优先使用 ChromaDB 的 MiniLM 本地向量；未安装 ChromaDB 时，
# 自动使用项目内置的本地 n-gram 向量索引，无需额外 embedding API。
# 如果你的 OpenAI-compatible 服务支持 embeddings，可改为 openai。
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=16
CHROMA_DB_DIR=db/chroma_db
CHROMA_COLLECTION_NAME=travel_guides

# 可选 Cross-Encoder 精排，默认 rule。设置为 dashscope 后使用 qwen3-rerank。
RERANK_PROVIDER=rule
RERANK_MODEL=qwen3-rerank
RERANK_BASE_URL=https://dashscope.aliyuncs.com/compatible-api/v1
RERANK_API_KEY=your_dashscope_api_key

# Redis 缓存可选项，当前默认关闭。关闭时使用进程内缓存。
RAG_REDIS_ENABLED=false
RAG_REDIS_URL=redis://127.0.0.1:6379/0
RAG_CACHE_TTL_SECONDS=21600

# 服务器配置
HOST=0.0.0.0
PORT=8000

# CORS配置
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# 日志级别
LOG_LEVEL=INFO

# Unsplash API Credentials
UNSPLASH_ACCESS_KEY=your_unsplash_access_key
UNSPLASH_SECRET_KEY=your_unsplash_secret_key

# 高德地图API配置
AMAP_API_KEY=your_amap_api_key
